# Copy this file to .env.local and fill in local values. Never commit .env.local.

# Supabase project (use only the public anon/publishable key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL for the API. Defaults to http://localhost:8787 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8787
