{
  "name": "@ledger-x/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .dev.vars -- wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy --minify",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun run openapi:check",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "openapi:check": "bun scripts/generate-openapi.ts --check",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:neon": "bun scripts/db-migrate.ts",
    "backup:supabase": "bash scripts/backup-supabase-to-r2.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "env:verify": "bash scripts/verify-env.sh",
    "import:supabase": "bun scripts/import-supabase-to-neon.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.18",
    "better-auth": "1.7.17",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@cloudflare/workers-types": "^4.20260610.1",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.99.0",
    "yaml": "^2.9.1"
  }
}
