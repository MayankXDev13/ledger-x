# Copy this file to .dev.vars and fill in local values. Never commit .dev.vars.

# --- Legacy Supabase (source only, read-only during migration) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Neon (target) ---
# Pooled Neon connection string used by wrangler dev for the HYPERDRIVE binding.
# In production, point the Hyperdrive binding (wrangler.jsonc) at the Neon pooled URL.
# Get this from Neon dashboard: pooled connection string.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Postgres connection string used by drizzle-kit (db:generate / db:migrate / db:studio).
# Point at the Neon branch during migration.
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
# Comma-separated trusted web origins for Better Auth + CORS (must include Pages URL in prod).
TRUSTED_ORIGINS=http://localhost:3000
